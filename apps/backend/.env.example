# Express server port (default: 4000)
PORT=4000

# Snowflake worker ID for unique short code generation (0-1023)
WORKER_ID=1

# Base URL used when constructing short link responses
BASE_URL=http://localhost:4000

# Redis connection string for URL caching and click queue (e.g., redis://localhost:6379 or redis://redis:6379 in Docker)
REDIS_URL=redis://localhost:6379

# MongoDB connection string (Get from MongoDB Atlas Dashboard -> Connect -> Drivers)
MONGO_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# MongoDB database name
MONGO_DB_NAME=urlshortener

# Supabase project URL used for JWKS token verification (Get from Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://<your-project-ref>.supabase.co

# Optional rate limiting configurations
RATE_LIMIT_ANON_CREATE=10
RATE_LIMIT_ANON_READ=100
RATE_LIMIT_FREE_CREATE=30
RATE_LIMIT_FREE_READ=1000
RATE_LIMIT_PRO_CREATE=300
RATE_LIMIT_PRO_READ=10000
